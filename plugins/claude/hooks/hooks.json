{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/atoll",
            "args": [
              "hook",
              "check-on-edit"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
