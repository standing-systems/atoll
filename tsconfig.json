{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "paths": {
      "@standing-systems/atoll": ["./src/index.ts"],
      "@standing-systems/atoll/testing": ["./src/testing.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "examples/**/*.ts", "build.mjs", "scripts/**/*.mjs"]
}
